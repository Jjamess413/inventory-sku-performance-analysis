{
  "name": "InventoryPortfolio",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-GB",
    "sourceQueryCulture": "en-GB",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "tables": [
      {
        "name": "FactTransactions",
        "lineageTag": "34ec8b26-73bd-5507-b7a7-02e794ba52d1",
        "columns": [
          {
            "name": "source_line_id",
            "dataType": "int64",
            "sourceColumn": "source_line_id",
            "lineageTag": "47d832e0-6a8c-5d33-9bb8-dc92e2807cf3",
            "summarizeBy": "none",
            "formatString": "#,0",
            "isHidden": true
          },
          {
            "name": "invoice_no",
            "dataType": "string",
            "sourceColumn": "invoice_no",
            "lineageTag": "c2267457-f03a-5158-9e05-aa87091a0833",
            "summarizeBy": "none"
          },
          {
            "name": "sku",
            "dataType": "string",
            "sourceColumn": "sku",
            "lineageTag": "2e598ad5-505c-5878-b4d2-244afc1ee04a",
            "summarizeBy": "none"
          },
          {
            "name": "date",
            "dataType": "dateTime",
            "sourceColumn": "date",
            "lineageTag": "68214086-5383-522a-b171-224d62ee9afe",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "quantity",
            "dataType": "int64",
            "sourceColumn": "quantity",
            "lineageTag": "5f015dd2-c44a-5ad2-b9d3-8371c3931573",
            "summarizeBy": "none",
            "formatString": "#,0"
          },
          {
            "name": "unit_price_pence",
            "dataType": "int64",
            "sourceColumn": "unit_price_pence",
            "lineageTag": "93716701-e8bd-5667-ab0e-9b8dca679f56",
            "summarizeBy": "none",
            "formatString": "#,0",
            "isHidden": true
          },
          {
            "name": "revenue_pence",
            "dataType": "int64",
            "sourceColumn": "revenue_pence",
            "lineageTag": "d6406b12-b6d4-579e-925d-2f9608608d93",
            "summarizeBy": "none",
            "formatString": "#,0",
            "isHidden": true
          },
          {
            "name": "country",
            "dataType": "string",
            "sourceColumn": "country",
            "lineageTag": "922ec528-ac63-50f9-9f96-2aeff6a8da64",
            "summarizeBy": "none"
          },
          {
            "name": "transaction_type",
            "dataType": "string",
            "sourceColumn": "transaction_type",
            "lineageTag": "10760113-64ea-5615-835d-d473710ecd97",
            "summarizeBy": "none"
          },
          {
            "name": "is_exact_repeat",
            "dataType": "int64",
            "sourceColumn": "is_exact_repeat",
            "lineageTag": "ee1f3bff-a68f-51d5-909b-0e8b53125ad5",
            "summarizeBy": "none",
            "formatString": "#,0",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "FactTransactions",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Source = fxLoadCsv(\"fact_transactions.csv\", {\n        {\"source_line_id\", Int64.Type}, {\"invoice_no\", type text}, {\"sku\", type text},\n        {\"date\", type date}, {\"quantity\", Int64.Type}, {\"unit_price_pence\", Int64.Type},\n        {\"revenue_pence\", Int64.Type}, {\"country\", type text},\n        {\"transaction_type\", type text}, {\"is_exact_repeat\", Int64.Type}\n    }),\n    TrimmedKeys = Table.TransformColumns(Source, {\n        {\"sku\", Text.Trim, type text}, {\"invoice_no\", Text.Trim, type text}\n    }),\n    Invalid = Table.SelectRows(TrimmedKeys, each\n        [sku] = null or [sku] = \"\" or [unit_price_pence] <= 0\n        or [revenue_pence] <> [quantity] * [unit_price_pence]\n    ),\n    Output = if Table.RowCount(Invalid) > 0\n        then error \"Unexpected transaction values. Review the pipeline output.\"\n        else TrimmedKeys\nin\n    Output\n"
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "measures": [
          {
            "name": "Gross Merchandise Sales GBP",
            "expression": "DIVIDE (\n    CALCULATE (\n        SUM ( FactTransactions[revenue_pence] ),\n        FactTransactions[transaction_type] = \"sale\"\n    ),\n    100\n)",
            "lineageTag": "5664ed93-25bc-53b5-8b96-1820127124c7",
            "formatString": "£#,0.00;(£#,0.00);£0.00",
            "displayFolder": "Historical sales"
          },
          {
            "name": "Gross Units",
            "expression": "CALCULATE (\n    SUM ( FactTransactions[quantity] ),\n    FactTransactions[transaction_type] = \"sale\"\n)",
            "lineageTag": "c30a29d1-bd2a-5750-b8ad-5ddb76614d21",
            "formatString": "#,0",
            "displayFolder": "Historical sales"
          },
          {
            "name": "Sales Orders",
            "expression": "CALCULATE (\n    DISTINCTCOUNT ( FactTransactions[invoice_no] ),\n    FactTransactions[transaction_type] = \"sale\"\n)",
            "lineageTag": "260f0299-91f4-53dd-a7a8-7fa4d59c802f",
            "formatString": "#,0",
            "displayFolder": "Historical sales"
          },
          {
            "name": "Active SKUs",
            "expression": "CALCULATE (\n    DISTINCTCOUNT ( FactTransactions[sku] ),\n    FactTransactions[transaction_type] = \"sale\"\n)",
            "lineageTag": "0f515d66-eacd-591a-95eb-52537e8a4b18",
            "formatString": "#,0",
            "displayFolder": "Historical sales"
          },
          {
            "name": "Cancellation Value GBP",
            "expression": "-DIVIDE (\n    CALCULATE (\n        SUM ( FactTransactions[revenue_pence] ),\n        FactTransactions[transaction_type] = \"cancellation\"\n    ),\n    100\n)",
            "lineageTag": "e1810635-6d9a-5fd8-a51b-2553ef71500f",
            "formatString": "£#,0.00;(£#,0.00);£0.00",
            "displayFolder": "Historical sales"
          },
          {
            "name": "Signed Transaction Value GBP",
            "expression": "[Gross Merchandise Sales GBP] - [Cancellation Value GBP]",
            "lineageTag": "3ad329ab-6642-5e98-8081-c40d75284701",
            "formatString": "£#,0.00;(£#,0.00);£0.00",
            "displayFolder": "Historical sales"
          },
          {
            "name": "Average Units Per Order",
            "expression": "DIVIDE ( [Gross Units], [Sales Orders] )",
            "lineageTag": "98e30f20-77b7-55e6-976d-36fd9fa949c0",
            "formatString": "#,0.00",
            "displayFolder": "Historical sales"
          },
          {
            "name": "SKU Revenue Rank",
            "expression": "IF (\n    NOT ISBLANK ( [Gross Merchandise Sales GBP] ),\n    RANKX (\n        ALLSELECTED ( DimSKU ),\n        [Gross Merchandise Sales GBP],\n        ,\n        DESC,\n        DENSE\n    )\n)",
            "lineageTag": "271511fc-8ca2-5dbb-bc24-f5783851e014",
            "formatString": "#,0",
            "displayFolder": "Historical sales"
          },
          {
            "name": "Gross Sales SUMX Check GBP",
            "expression": "DIVIDE (\n    SUMX (\n        FILTER ( FactTransactions, FactTransactions[transaction_type] = \"sale\" ),\n        FactTransactions[quantity] * FactTransactions[unit_price_pence]\n    ),\n    100\n)",
            "lineageTag": "b8a50e16-49bc-5579-92ed-d681e024e8cd",
            "formatString": "£#,0.00;(£#,0.00);£0.00",
            "displayFolder": "Historical sales"
          },
          {
            "name": "Gross Sales Calculation Difference GBP",
            "expression": "[Gross Merchandise Sales GBP] - [Gross Sales SUMX Check GBP]",
            "lineageTag": "8ea26beb-80c6-589a-a412-398c47cb83b5",
            "formatString": "£#,0.00;(£#,0.00);£0.00",
            "displayFolder": "Historical sales"
          },
          {
            "name": "Scenario On Hand Units",
            "expression": "SUM ( InventoryScenario[on_hand_units] )",
            "lineageTag": "7236eb84-b22e-5d35-a3c4-cebc4d8ba013",
            "formatString": "#,0",
            "displayFolder": "Scenario (synthetic)"
          },
          {
            "name": "Scenario SKUs Due Reorder Review",
            "expression": "CALCULATE (\n    COUNTROWS ( InventoryScenario ),\n    InventoryScenario[scenario_flag] = \"Reorder review\"\n)",
            "lineageTag": "99b85920-5fb1-552d-989a-0ba48690c8bc",
            "formatString": "#,0",
            "displayFolder": "Scenario (synthetic)"
          },
          {
            "name": "Scenario SKUs Excess Cover Review",
            "expression": "CALCULATE (\n    COUNTROWS ( InventoryScenario ),\n    InventoryScenario[scenario_flag] = \"Excess cover review\"\n)",
            "lineageTag": "523acedd-63e3-5819-a14c-b021c3e55a7d",
            "formatString": "#,0",
            "displayFolder": "Scenario (synthetic)"
          },
          {
            "name": "Scenario SKUs Manual Review",
            "expression": "CALCULATE (\n    COUNTROWS ( InventoryScenario ),\n    InventoryScenario[scenario_flag] = \"Manual review\"\n)",
            "lineageTag": "fedda1d0-5cf1-51fa-bffa-82bc8df08aad",
            "formatString": "#,0",
            "displayFolder": "Scenario (synthetic)"
          },
          {
            "name": "Scenario Suggested Order Units",
            "expression": "SUM ( InventoryScenario[suggested_order_units] )",
            "lineageTag": "fce797d3-1f2b-559b-b7ea-e59766f65a7a",
            "formatString": "#,0",
            "displayFolder": "Scenario (synthetic)"
          },
          {
            "name": "Scenario Label",
            "expression": "\"Synthetic stock scenario | 30 November 2011 | Fixed 90-day lookback\"",
            "lineageTag": "8bd62c5e-4fd4-5554-af40-c985bc7c8c1f",
            "displayFolder": "Scenario (synthetic)"
          },
          {
            "name": "ABC Share of Sales",
            "expression": "DIVIDE([Gross Merchandise Sales GBP], CALCULATE([Gross Merchandise Sales GBP], REMOVEFILTERS(DimSKU[abc_class])))",
            "lineageTag": "27154304-3458-5a64-936c-b030fba7be02",
            "formatString": "0.00%",
            "displayFolder": "Historical sales"
          },
          {
            "name": "Top Ten SKU Sales GBP",
            "expression": "IF(SELECTEDVALUE(DimSKU[revenue_rank], 999999) <= 10, [Gross Merchandise Sales GBP])",
            "lineageTag": "0c098e2e-1ded-52b6-aea0-4223e43d2e55",
            "formatString": "£#,0.00;(£#,0.00);£0.00",
            "displayFolder": "Historical sales"
          },
          {
            "name": "SKU Units Rank",
            "expression": "IF(NOT ISBLANK([Gross Units]), RANKX(ALLSELECTED(DimSKU), [Gross Units], , DESC, DENSE))",
            "lineageTag": "e1dfd3f2-9570-5b29-8412-884373ab29b0",
            "formatString": "#,0",
            "displayFolder": "Historical sales"
          },
          {
            "name": "Top Ten SKU Units",
            "expression": "IF([SKU Units Rank] <= 10, [Gross Units])",
            "lineageTag": "891969b5-1196-51d1-b11e-fdcd157f9423",
            "formatString": "#,0",
            "displayFolder": "Historical sales"
          },
          {
            "name": "Previous Month Sales GBP",
            "expression": "CALCULATE([Gross Merchandise Sales GBP], DATEADD(DimDate[date], -1, MONTH))",
            "lineageTag": "4165f2ce-10c5-5ac4-a42d-358473ee2e4f",
            "formatString": "£#,0.00;(£#,0.00);£0.00",
            "displayFolder": "Historical sales"
          },
          {
            "name": "Sales MoM %",
            "expression": "DIVIDE([Gross Merchandise Sales GBP] - [Previous Month Sales GBP], [Previous Month Sales GBP])",
            "lineageTag": "531cf12f-8a8f-5e83-a60b-ba890ef11f86",
            "formatString": "0.00%",
            "displayFolder": "Historical sales"
          },
          {
            "name": "Previous Month Units",
            "expression": "CALCULATE([Gross Units], DATEADD(DimDate[date], -1, MONTH))",
            "lineageTag": "9bdda079-5ac1-5389-aa83-b5ed53a60991",
            "formatString": "#,0",
            "displayFolder": "Historical sales"
          },
          {
            "name": "Units MoM %",
            "expression": "DIVIDE([Gross Units] - [Previous Month Units], [Previous Month Units])",
            "lineageTag": "9a6f3009-9811-5f8d-9e46-7772e348793c",
            "formatString": "0.00%",
            "displayFolder": "Historical sales"
          }
        ]
      },
