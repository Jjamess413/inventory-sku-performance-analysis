      }
    ],
    "expressions": [
      {
        "name": "pDataFolder",
        "kind": "m",
        "expression": "\"C:/InventoryPortfolio/data/processed/\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      },
      {
        "name": "fxLoadCsv",
        "kind": "m",
        "expression": "// Create pDataFolder as a Text parameter with a trailing path separator.\n// Create this function as one blank query named fxLoadCsv.\n(FileName as text, ColumnTypes as list) as table =>\nlet\n    Source = Csv.Document(\n        File.Contents(pDataFolder & FileName),\n        [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]\n    ),\n    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),\n    BlankToNull = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),\n    Typed = Table.TransformColumnTypes(BlankToNull, ColumnTypes, \"en-AU\")\nin\n    Typed\n"
      }
    ],
    "annotations": [
      {
        "name": "PBI_TimeIntelligenceEnabled",
        "value": "0"
      },
      {
        "name": "PortfolioDataNature",
        "value": "Public historical sales; inventory balances and lead times are synthetic"
      }
    ]
  }
}
