            "source": {
              "type": "m",
              "expression": "let\n    Source = fxLoadCsv(\"inventory_scenario.csv\", {\n        {\"sku\", type text}, {\"snapshot_date\", type date}, {\"data_nature\", type text},\n        {\"on_hand_units\", Int64.Type}, {\"on_order_units\", Int64.Type}, {\"reserved_units\", Int64.Type},\n        {\"lead_time_days\", Int64.Type}, {\"inventory_position_units\", Int64.Type},\n        {\"mean_daily_units\", type number}, {\"std_daily_units\", type number}, {\"days_cover\", type number},\n        {\"safety_stock_units\", Int64.Type}, {\"reorder_point_units\", Int64.Type},\n        {\"target_stock_units\", Int64.Type}, {\"suggested_order_units\", Int64.Type},\n        {\"demand_status\", type text}, {\"scenario_flag\", type text}, {\"abc_class\", type text}\n    }),\n    Selected = Table.SelectColumns(Source, {\n        \"sku\", \"snapshot_date\", \"data_nature\", \"on_hand_units\", \"on_order_units\", \"reserved_units\",\n        \"lead_time_days\", \"inventory_position_units\", \"mean_daily_units\", \"std_daily_units\", \"days_cover\",\n        \"safety_stock_units\", \"reorder_point_units\", \"target_stock_units\", \"suggested_order_units\",\n        \"demand_status\", \"scenario_flag\", \"abc_class\"\n    }),\n    InvalidNature = Table.SelectRows(Selected, each [data_nature] <> \"SYNTHETIC_SCENARIO\"),\n    Output = if Table.RowCount(InvalidNature) > 0\n        then error \"Inventory rows must retain their synthetic scenario label.\"\n        else Selected\nin\n    Output\n"
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "450fd73a-fc02-50b7-a948-0cd25b70ceac",
        "fromTable": "FactTransactions",
        "fromColumn": "sku",
        "toTable": "DimSKU",
        "toColumn": "sku",
        "fromCardinality": "many",
        "toCardinality": "one",
